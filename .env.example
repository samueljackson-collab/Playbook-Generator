# Playbook Generator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# Optional: API key required to authenticate requests to /api/git/commit.
# Clients must send this value in the "X-API-Key" request header.
# If unset, authentication is DISABLED for this endpoint (convenient for local dev,
# but unsafe for any environment reachable beyond localhost).
API_KEY=

# Optional: Comma-separated allowlist of git remote hostnames that /api/git/commit
# is permitted to clone/push to. Defaults to "github.com" if unset.
# Example: ALLOWED_GIT_HOSTS=github.com,gitlab.com
ALLOWED_GIT_HOSTS=github.com
